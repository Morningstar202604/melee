{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melee.local/schema/battle-event.schema.json",
  "title": "BattleEvent",
  "description": "一场比赛内被追加到事件日志的唯一事实来源。所有 UI 状态都必须可由 reduce(events) 重算。用 oneOf 判别联合表达，便于生成 zod/pydantic 的强类型。",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "seq",
        "matchId",
        "type",
        "at"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "从 0 开始、严格单调递增、无空洞。断线重连与回放的锚点。"
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "visibility": {
          "description": "public = 所有人可见；players = 仅列出的选手可见（服务端发送前过滤）。",
          "oneOf": [
            {
              "const": "public"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "players"
              ],
              "properties": {
                "players": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "MatchCreated",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "match.created"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "game",
                "players"
              ],
              "properties": {
                "game": {
                  "type": "string"
                },
                "players": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "seed": {
                  "type": "integer",
                  "description": "公开的种子。仅 replay 模式（调用方显式指定种子）与历史事件包含；secure 模式下种子由服务端保存，不写进事件。"
                },
                "config": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "MatchStarted",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "match.started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "firstPlayer"
              ],
              "properties": {
                "firstPlayer": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "RoundStarted",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "round.started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "round",
                "activePlayers"
              ],
              "properties": {
                "round": {
                  "type": "integer",
                  "minimum": 1
                },
                "activePlayers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "TurnStarted",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "turn.started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "deadlineMs": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "回合时限（毫秒）。未配置时不写此字段——写 null 会让契约校验失败。"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ThoughtDelta",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "player",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "thought.delta"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ActionProposed",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "player",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "action.proposed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "raw"
              ],
              "properties": {
                "action": {
                  "type": "object",
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "ask",
                        "guess",
                        "forfeit"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                "raw": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ActionRejected",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "player",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "action.rejected"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "retryable"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "maxLength": 500
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ActionApplied",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "player",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "action.applied"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "effects"
              ],
              "properties": {
                "action": {
                  "type": "object",
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "ask",
                        "guess",
                        "forfeit"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "elapsedMs": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "这一手从发起请求到拿到动作的墙钟耗时（毫秒）。只记录真实观测值，猜不出来就不写。"
                },
                "usage": {
                  "type": "object",
                  "description": "可选的上游用量（如 tokens / requests）。没有就不写，不编数。"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "StateChanged",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "state.changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publicState",
                "deltas"
              ],
              "properties": {
                "publicState": {
                  "type": "object"
                },
                "deltas": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "NarrationLine",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "narration.line"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "refs"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 240
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "neutral",
                    "tension",
                    "reveal",
                    "turn"
                  ]
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "msg": {
                  "type": "string",
                  "maxLength": 80,
                  "description": "语言无关的文案模板键；读取方按自己的语言重新展开。缺省表示这是纯文本（老事件）。"
                },
                "params": {
                  "type": "object",
                  "description": "模板参数，与 msg 配套。"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "MatchEnded",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "match.ended"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "winner",
                "reason",
                "finalState"
              ],
              "properties": {
                "winner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 200
                },
                "finalState": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "DirectorCue",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "matchId",
            "type",
            "at",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "matchId": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "visibility": {
              "type": [
                "string",
                "object"
              ]
            },
            "player": {
              "type": "string"
            },
            "type": {
              "const": "director.cue"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shot",
                "durationMs"
              ],
              "properties": {
                "shot": {
                  "type": "string",
                  "enum": [
                    "wide",
                    "close",
                    "thought",
                    "reveal",
                    "slowmo"
                  ]
                },
                "target": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "trigger": {
                  "type": "string",
                  "maxLength": 200
                },
                "triggerKey": {
                  "type": "string",
                  "maxLength": 80,
                  "description": "触发原因的模板键；读取方按语言重新展开。缺省表示纯文本。"
                },
                "triggerParams": {
                  "type": "object",
                  "description": "模板参数，与 triggerKey 配套。"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
