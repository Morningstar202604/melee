# 统一行尾：脚本必须是 LF，否则 Linux CI 上 bash 会报 $'\r': command not found
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.webm binary
