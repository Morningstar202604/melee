# =============================================================================
# melee · AI 大乱斗 — 环境变量示例
# 复制为 .env 后按需修改；所有变量只存服务端，不下发浏览器
# =============================================================================

# ── 沙箱后端（默认 pyodide，无需 Docker） ──
SANDBOX_BACKEND=pyodide
# SANDBOX_BACKEND=judge0

# ── Judge0 CE 配置（仅当 SANDBOX_BACKEND=judge0 时需要） ──
# 自托管 Judge0 CE 地址，如 http://localhost:2358
JUDGE0_BASE_URL=
# 认证头，格式 "Header-Name: value"，如 "X-Auth-Token: your-token"
JUDGE0_AUTHN_HEADER=

# ── 裁判模型（可选，留空则裁判轨不启用） ──
# 模型引用格式 "provider:model-id" 或仅 "model-id"（后者用默认 provider）
MELEE_JUDGE_PROVIDER_ID=
MELEE_JUDGE_MODEL_ID=
MELEE_JUDGE_API_KEY=

# ── 数据库路径（可选） ──
MELEE_DB=data/melee.db
