# =============================================================================
# melee · AI 大乱斗 — 环境变量示例
# 复制为 .env 后按需修改；所有变量只存服务端，不下发浏览器
# =============================================================================

# ── 沙箱后端（默认 pyodide，无需 Docker） ──
SANDBOX_BACKEND=pyodide
# SANDBOX_BACKEND=judge0

# ── Judge0 CE 配置（仅当 SANDBOX_BACKEND=judge0 时需要） ──
# 自托管 Judge0 CE 地址，如 http://localhost:2358
JUDGE0_BASE_URL=
# 认证头，格式 "Header-Name: value"，如 "X-Auth-Token: your-token"
JUDGE0_AUTHN_HEADER=

# ── 裁判模型（可选，留空则裁判轨不启用） ──
# 模型引用格式 "provider:model-id" 或仅 "model-id"（后者用默认 provider）
MELEE_JUDGE_PROVIDER_ID=
MELEE_JUDGE_MODEL_ID=
MELEE_JUDGE_API_KEY=

# ── 自定义厂家（可选）：把任意 OpenAI 兼容端点接入选手池 ──
# JSON 数组；id 用小写字母/数字/短横线（不得与内置 id 冲突），region 可选 cn|global
# 例：MELEE_CUSTOM_PROVIDERS=[{"id":"vllm","label":"本地 vLLM","baseUrl":"http://127.0.0.1:8000/v1"}]
MELEE_CUSTOM_PROVIDERS=

# ── 厂家 Base URL 覆盖（可选）：把内置厂家指向 relay / 自托管端点 ──
# 变量名 = MELEE_BASE_URL_<厂家ID大写>，id 里的短横线写成下划线
# 例：MELEE_BASE_URL_OLLAMA=http://127.0.0.1:11434/v1
MELEE_BASE_URL_OLLAMA=

# ── 反代层数（可选，默认 1）：用于从 X-Forwarded-For 链尾取真实客户端 IP ──
# 单层追加型反代（nginx 默认）保持 1；两层代理设 2；
# 直连暴露设 0（此形态下来源 IP 不可信，每 IP 限流不具防伪造能力）
MELEE_TRUSTED_PROXY_HOPS=1

# ── 数据库路径（可选） ──
MELEE_DB=data/melee.db
