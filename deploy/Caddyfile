# Caddy 反代：静态前端与 API 同源。
#
# 前端是零构建的静态页面，但所有数据都从同源路径取（/stats、/archive、
# /matches/.../stream）。所以静态站不能只有 file-server：除了页面与静态资源，
# 其余路径全部转给 match 服务。
#
# 使用：docker compose up（web 容器挂载本文件）

:80 {
	root * /srv
	encode gzip

	# SSE 必须关缓冲，否则事件会被攒到连接结束才吐出来。
	@stream path /matches/*/stream
	reverse_proxy @stream match:8099 {
		flush_interval -1
	}

	# 页面与静态资源由 Caddy 直接出。
	@static path / /index.html /watch.html /season.html /recap.html /director.html /src/* /vendor/*
	file_server @static

	# 其余（/matches、/archive、/stats、/seasons、/share、/card.png…）全部转给 API。
	reverse_proxy match:8099
}
